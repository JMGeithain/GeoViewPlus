+    def open_vm_directory_viewer(self):
+        """Show validated PC/GEOS 2.x VM-directory entries without semantic guesses."""
+        info = getattr(self, 'vm_directory_info', None)
+        if info is None:
+            messagebox.showinfo('VM-Blöcke', 'Für diese Datei liegt kein geprüftes VM-Verzeichnis vor.')
+            return
+        win = tk.Toplevel(self)
+        win.title('GeoViewPlus – PC/GEOS-2.x VM-Blöcke')
+        win.geometry('900x560')
+        ttk.Label(
+            win,
+            text=(f"Directory 0x{info.directory_file_offset:X} · "
+                  f"{len(info.allocated_entries)} belegte Blöcke · "
+                  f"Map-Handle 0x{info.map_block_handle:04X} · "
+                  f"DB-Map-Handle 0x{info.db_map_block_handle:04X}"),
+            anchor='w'
+        ).pack(fill=tk.X, padx=8, pady=6)
+        columns = ('index', 'vm_handle', 'memory_handle', 'user_id', 'flags', 'size', 'file_offset')
+        tree = ttk.Treeview(win, columns=columns, show='headings')
+        headings = {'index':'Index', 'vm_handle':'VM-Handle', 'memory_handle':'Mem-Handle',
+                    'user_id':'User-ID', 'flags':'Flags', 'size':'Größe', 'file_offset':'Datei-Offset'}
+        widths = {'index':65, 'vm_handle':95, 'memory_handle':105, 'user_id':90,
+                  'flags':80, 'size':85, 'file_offset':115}
+        for col in columns:
+            tree.heading(col, text=headings[col])
+            tree.column(col, width=widths[col], anchor='center')
+        yscroll = ttk.Scrollbar(win, orient='vertical', command=tree.yview)
+        tree.configure(yscrollcommand=yscroll.set)
+        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(8,0), pady=(0,8))
+        yscroll.pack(side=tk.RIGHT, fill=tk.Y, pady=(0,8))
+        for entry in info.allocated_entries:
+            tree.insert('', 'end', values=(
+                entry.index, f'0x{entry.vm_handle:04X}', f'0x{entry.memory_handle:04X}',
+                f'0x{entry.user_id:04X}', f'0x{entry.flags:04X}', f'0x{entry.size:04X}',
+                f'0x{entry.file_offset:06X}'
+            ))
+        ttk.Label(
+            win,
+            text='User-IDs und Blockinhalte werden hier bewusst nur numerisch angezeigt; '
+                 'die Zuordnung zu Token-Einträgen und Icons ist noch Gegenstand der Analyse.',
+            wraplength=860, justify='left'
+        ).pack(fill=tk.X, padx=8, pady=(0,8))
+
